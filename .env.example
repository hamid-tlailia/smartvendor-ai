# =============================================================================
# SmartVendor AI (OmniSell AI) — environment variables
# Copy relevant sections into backend/.env and frontend/.env.local
# =============================================================================

# --------------------------- Backend (backend/.env) --------------------------
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Base URL of the deployed checkout PWA; used to build /checkout/:cartId links.
CHECKOUT_BASE_URL=http://localhost:5173

# Supabase — Project Settings -> API. Service role key is server-only, never
# expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# WhatsApp Cloud API — Meta for Developers -> WhatsApp -> Configuration
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
META_GRAPH_API_VERSION=v20.0

# Instagram DM + Facebook Messenger share one Meta app/page token
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=choose-a-random-verify-token

# TikTok Direct Messaging (TikTok for Business API)
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_VERIFY_TOKEN=choose-a-random-verify-token
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# Vector search tuning
VECTOR_MATCH_THRESHOLD=0.72
VECTOR_MATCH_COUNT=5

# Admin dashboard auth — JWT issued by /api/auth/login and /api/auth/register
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase Storage bucket the generated receipt PDFs/images are uploaded to
# (Storage -> New bucket -> name it "receipts" -> make it public)
SUPABASE_RECEIPTS_BUCKET=receipts

# Path to a Chromium/Chrome binary, used by puppeteer-core to render the
# Arabic RTL order receipt to PDF/PNG. Required on most hosts (Docker, Fly.io,
# Render); can be left unset locally if a system Chrome is auto-discovered.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ------------------------ Frontend (frontend/.env.local) ---------------------
VITE_API_URL=http://localhost:4000
